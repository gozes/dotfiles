// niri config — Noctalia shell, Ghostty terminal, en-US Dvorak + home row mods.
// Docs: https://github.com/niri-wm/niri/wiki  /  https://docs.noctalia.dev/noctalia/compositor-settings/niri/
//
// HOME ROW MODS — keymap design rule
// ----------------------------------
// Home row mods are produced *outside* niri (keyd / kanata / QMK / ZMK); niri
// has no tap-hold, it just sees the Super/Alt/Ctrl/Shift those tools emit.
// With a Miryoku-style Dvorak GACS layout your home row keys ARE the modifiers:
//     left  a=Super  o=Alt  e=Ctrl  u=Shift
//     right s=Super  n=Alt  t=Ctrl  h=Shift
// So NONE of a o e u i / d h t n s are safe as the *tapped* key in a Mod bind —
// tapping a key that's also a hold-modifier is exactly what home row mods make
// ambiguous. Every bind below taps an arrow, a number, or a non-home-row letter
// (q r f g c l v w p ; , . [ ]) with the Super you get from holding a/s.
//
// EXCEPTION — vim hjkl navigation (matches my nvim muscle memory)
// ----------------------------------------------------------------
// Focus/move/resize use h j k l to mirror nvim's <C-hjkl> splits. Of those,
// only `h` is a home-row-mod key (Shift when held); j k l are off the home
// row. Super comes from the LEFT hand (hold a) while the right hand taps
// h/j/k/l — same shape as tapping <C-h> in nvim, which already works daily.
// A quick tap of h resolves to the letter, not Shift.

input {
    keyboard {
        xkb {
            layout "us"
            // Home row mods come from keyd/kanata/QMK, not xkb. If you ever drop
            // them and want Caps as Ctrl instead: options "ctrl:nocaps"
        }
        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
        natural-scroll
        dwt            // disable-while-typing
    }

    warp-mouse-to-focus
}

hotkey-overlay {
    // Avoid auto-showing the important hotkeys menu.
    skip-at-startup
    hide-not-bound
}
// niri auto-detects outputs. Pin one if needed:
// output "eDP-1" { scale 1.5 }

layout {
    gaps 4
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7aa2f7"
        inactive-color "#3b4261"
    }
}

prefer-no-csd

// ---- Startup --------------------------------------------------------------
spawn-at-startup "noctalia"
// Internal laptop panel off when an external display is connected, on when not.
// Works with one display or laptop+external. See laptop-panel.sh.
spawn-at-startup "bash" "-c" "~/.config/niri/laptop-panel.sh"
// polkit agent for privilege prompts (adjust path to your distro):
// spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

environment {
    DISPLAY ":0"       // for XWayland apps
    QT_QPA_PLATFORM "wayland"
    MOZ_ENABLE_WAYLAND "1"
}

screenshot-path "~/Pictures/Screenshots/Screenshot-%Y%m%d-%H%M%S.png"

// Noctalia needs this for notification actions + window activation.
debug {
    honor-xdg-activation-with-invalid-serial
}

// ---- Keybinds -------------------------------------------------------------
// Tapped keys avoid the home row on purpose (see header). Super = hold a or s.
binds {
    Mod+Alt+Slash { show-hotkey-overlay; }

    // Apps & shell
    Mod+Space   { spawn "ghostty"; }
    Mod+Return  hotkey-overlay-title="Noctalia launcher"  { spawn-sh "noctalia msg panel-toggle launcher"; }
    Alt+Tab     hotkey-overlay-title="Noctalia winodow swtiching" { spawn-sh "noctalia msg window-switcher hold"; }

    // Screenshots via Noctalia
    Mod+Ctrl+P   hotkey-overlay-title="Noctalia scrennshot region" { spawn-sh "noctalia msg screenshot-region"; }
    Shift+Print { spawn-sh "noctalia msg screenshot-fullscreen"; }
    Mod+Shift+P  hotkey-overlay-title="Noctalia scrennshot annotetion" { spawn-sh "noctalia msg screenshot-annotate"; }

    // Audio & brightness — Noctalia OSD (hardware keys, usable while locked)
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // Media transport
    XF86AudioPlay { spawn-sh "noctalia msg media play-pause"; }
    XF86AudioNext { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev { spawn-sh "noctalia msg media previous"; }

    Mod+Escape hotkey-overlay-title="Noctalia lock screnn" { spawn-sh "noctalia msg session lock"; }
    // -------------------------------------------------------------------

     // Window and column behavior.
    Mod+Q repeat=false hotkey-overlay-title="Close window" { close-window; }
    Mod+O repeat=false hotkey-overlay-title="Toggle overview (4-finger swipe)" { toggle-overview; }

    Mod+C      hotkey-overlay-title="Center column" { center-column; }
    Mod+Ctrl+C hotkey-overlay-title="Center all visible columns" { center-visible-columns; }
    Mod+Alt+C   hotkey-overlay-title="Noctalia cotrol center"     { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Shift+C  hotkey-overlay-title="Noctalia settings"{ spawn-sh "noctalia msg settings-toggle"; }

    Mod+Z      hotkey-overlay-title="Toggle floating window" { toggle-window-floating; }
    Mod+Ctrl+Z hotkey-overlay-title="Switch focus between floating and tiling"{ switch-focus-between-floating-and-tiling; }

    Mod+T hotkey-overlay-title="Toggle tabbed column" { toggle-column-tabbed-display; }

    Mod+BracketLeft  hotkey-overlay-title="Move focused window in and out of column to the left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Move focused window in and out of column to the right" { consume-or-expel-window-right; }
    Mod+Comma        hotkey-overlay-title="Move right window under focused column" { consume-window-into-column; }
    Mod+Period       hotkey-overlay-title="Remove bottom window from focused column" { expel-window-from-column; }

    // Window and column sizes.
    Mod+F       hotkey-overlay-title="Maximize column" { maximize-column; }
    Mod+Alt+F hotkey-overlay-title="Full screen window" { fullscreen-window; }
    Mod+Ctrl+F  hotkey-overlay-title="Fill empty column space" { expand-column-to-available-width; }

    Mod+R       hotkey-overlay-title="Cycle preset widths" { switch-preset-column-width; }
    Mod+Alt+R hotkey-overlay-title="Cycle preset heights" { switch-preset-window-height; }
    Mod+Ctrl+R  hotkey-overlay-title="Reset window height" { reset-window-height; }

    Mod+Equal       hotkey-overlay-title="Increase column width" { set-column-width "+10%"; }
    Mod+Minus       hotkey-overlay-title="Decrease column width" { set-column-width "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Increase window height" { set-window-height "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="Decrease window height" { set-window-height "-10%"; }

    // Window and column movement.
    Mod+I hotkey-overlay-title="Focus previously focused window" { focus-window-previous; }

    Mod+H     hotkey-overlay-title="Focus column left" { focus-column-left; }
    Mod+J     hotkey-overlay-title="Focus column down" { focus-window-down; }
    Mod+K     hotkey-overlay-title="Focus column up" { focus-window-up; }
    Mod+L     hotkey-overlay-title="Focus column down" { focus-column-right; }
    Mod+Left  hotkey-overlay-title="Focus column left" { focus-column-left; }
    Mod+Down  hotkey-overlay-title="Focus column down" { focus-window-down; }
    Mod+Up    hotkey-overlay-title="Focus column up" { focus-window-up; }
    Mod+Right hotkey-overlay-title="Focus column right" { focus-column-right; }

    Mod+Alt+H     hotkey-overlay-title="Move column left" { move-column-left; }
    Mod+Alt+J     hotkey-overlay-title="Move column down" { move-window-down; }
    Mod+Alt+K     hotkey-overlay-title="Move column up" { move-window-up; }
    Mod+Alt+L     hotkey-overlay-title="Move column down" { move-column-right; }
    Mod+Ctrl+Left  hotkey-overlay-title="Move column left" { move-column-left; }
    Mod+Ctrl+Down  hotkey-overlay-title="Move column down" { move-window-down; }
    Mod+Ctrl+Up    hotkey-overlay-title="Move column up" { move-window-up; }
    Mod+Ctrl+Right hotkey-overlay-title="Move column right" { move-column-right; }

    Mod+G              hotkey-overlay-title="Focus first column" { focus-column-first; }
    Mod+SemiColon      hotkey-overlay-title="Focus last column" { focus-column-last; }
    Mod+Alt+G         hotkey-overlay-title="Move column to first" { move-column-to-first; }
    Mod+Alt+SemiColon hotkey-overlay-title="Move column to last" { move-column-to-last; }
    Mod+Home           hotkey-overlay-title="Focus first column" { focus-column-first; }
    Mod+End            hotkey-overlay-title="Focus last column" { focus-column-last; }
    Mod+Ctrl+Home      hotkey-overlay-title="Move column to first" { move-column-to-first; }
    Mod+Ctrl+End       hotkey-overlay-title="Move column to last" { move-column-to-last; }
    Mod+S       hotkey-overlay-title="Swap window right" { swap-window-right; }
    Mod+Alt+S       hotkey-overlay-title="Swap window left" { swap-window-left; }

    Mod+WheelScrollDown       hotkey-overlay-title="Focus column right" { focus-column-right; }
    Mod+WheelScrollUp         hotkey-overlay-title="Focus column left" { focus-column-left; }
    Mod+Alt+WheelScrollDown  hotkey-overlay-title="Move column right" { move-column-right; }
    Mod+Alt+WheelScrollUp    hotkey-overlay-title="Move column left" { move-column-left; }
    Mod+WheelScrollRight      hotkey-overlay-title="Focus column right" { focus-column-right; }
    Mod+WheelScrollLeft       hotkey-overlay-title="Focus column left" { focus-column-left; }
    Mod+Alt+WheelScrollRight hotkey-overlay-title="Move column right" { move-column-right; }
    Mod+Alt+WheelScrollLeft  hotkey-overlay-title="Move column left" { move-column-left; }

    // Multiple monitor window and column movement.
    Mod+Alt+Shift+H     hotkey-overlay-title="Move column to left monitor" { move-column-to-monitor-left; }
    Mod+Alt+Shift+J     hotkey-overlay-title="Move column to lower monitor" { move-column-to-monitor-down; }
    Mod+Alt+Shift+K     hotkey-overlay-title="Move column to upper monitor" { move-column-to-monitor-up; }
    Mod+Alt+Shift+L     hotkey-overlay-title="Move column to right monitor" { move-column-to-monitor-right; }
    Mod+Alt+Shift+Left  hotkey-overlay-title="Move column to left monitor" { move-column-to-monitor-left; }
    Mod+Alt+Shift+Down  hotkey-overlay-title="Move column to lower monitor" { move-column-to-monitor-down; }
    Mod+Alt+Shift+Up    hotkey-overlay-title="Move column to upper monitor" { move-column-to-monitor-up; }
    Mod+Alt+Shift+Right hotkey-overlay-title="Move column to right monitor" { move-column-to-monitor-right; }

    Mod+MouseBack               hotkey-overlay-title="Focus left monitor" { focus-monitor-left; }
    Mod+MouseForward            hotkey-overlay-title="Focus right monitor" { focus-monitor-right; }
    Mod+Alt+Shift+MouseBack    hotkey-overlay-title="Move column to left monitor" { move-column-to-monitor-left; }
    Mod+Alt+Shift+MouseForward hotkey-overlay-title="Move column to right monitor" { move-column-to-monitor-right; }

    // Workspaces.
    Mod+Shift+WheelScrollDown      cooldown-ms=150 hotkey-overlay-title="Focus next workspace" { focus-workspace-down; }
    Mod+Shift+WheelScrollUp        cooldown-ms=150 hotkey-overlay-title="Focus previous workspace" { focus-workspace-up; }
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Move column to next workspace" { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp   cooldown-ms=150 hotkey-overlay-title="Move column to previous workspace" { move-column-to-workspace-up; }

    Mod+D               hotkey-overlay-title="Focus next workspace" { focus-workspace-down; }
    Mod+U               hotkey-overlay-title="Focus previous workspace" { focus-workspace-up; }
    Mod+Page_Down       hotkey-overlay-title="Focus next workspace" { focus-workspace-down; }
    Mod+Page_Up         hotkey-overlay-title="Focus previous workspace" { focus-workspace-up; }
    Mod+Alt+D          hotkey-overlay-title="Move column to next workspace" { move-column-to-workspace-down; }
    Mod+Alt+U          hotkey-overlay-title="Move column to previous workspace" { move-column-to-workspace-up; }
    Mod+Alt+Page_Down  hotkey-overlay-title="Move column to next workspace" { move-column-to-workspace-down; }
    Mod+Alt+Page_Up    hotkey-overlay-title="Move column to previous workspace" { move-column-to-workspace-up; }
    Mod+Alt+Shift+D         hotkey-overlay-title="Move workspace down" { move-workspace-down; }
    Mod+Alt+Shift+U         hotkey-overlay-title="Move workspace up" { move-workspace-up; }
    Mod+Alt+Shift+Page_Down hotkey-overlay-title="Move workspace down" { move-workspace-down; }
    Mod+Alt+Shift+Page_Up   hotkey-overlay-title="Move workspace up" { move-workspace-up; }

    Mod+1 hotkey-overlay-title="Focus workspace (1-9)" { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Alt+1 hotkey-overlay-title="Move window to workspace (1-9)" { move-window-to-workspace 1; }
    Mod+Alt+2 { move-window-to-workspace 2; }
    Mod+Alt+3 { move-window-to-workspace 3; }
    Mod+Alt+4 { move-window-to-workspace 4; }
    Mod+Alt+5 { move-window-to-workspace 5; }
    Mod+Alt+6 { move-window-to-workspace 6; }
    Mod+Alt+7 { move-window-to-workspace 7; }
    Mod+Alt+8 { move-window-to-workspace 8; }
    Mod+Alt+9 { move-window-to-workspace 9; }

    Mod+Alt+Shift+1 hotkey-overlay-title="Move column to workspace (1-9)" { move-column-to-workspace 1; }
    Mod+Alt+Shift+2 { move-column-to-workspace 2; }
    Mod+Alt+Shift+3 { move-column-to-workspace 3; }
    Mod+Alt+Shift+4 { move-column-to-workspace 4; }
    Mod+Alt+Shift+5 { move-column-to-workspace 5; }
    Mod+Alt+Shift+6 { move-column-to-workspace 6; }
    Mod+Alt+Shift+7 { move-column-to-workspace 7; }
    Mod+Alt+Shift+8 { move-column-to-workspace 8; }
    Mod+Alt+Shift+9 { move-column-to-workspace 9; }

    // Apps such as remote-desktop clients and software KVM switches may request
    // that niri stops processing the keyboard shortcuts defined here so they
    // may, for example, forward the key presses as-is to a remote machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor, so a
    // buggy application can't hold your session hostage.
    //
    // allow-inhibiting=false can be applied to other binds as well, which
    // ensures niri always processes them, even when an inhibitor is active.
    Mod+Alt+Escape allow-inhibiting=false hotkey-overlay-title="Always process even with inhibitor" { toggle-keyboard-shortcuts-inhibit; }


}

// ---- Window rules ---------------------------------------------------------
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// Float Noctalia's own settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// ---- Layer rules (niri 26.04+) -------------------------------------------
// Blurred wallpaper copy inside niri's overview backdrop.
// Requires Noctalia's [niri/backdrop] section enabled.
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// Blur behind Noctalia surfaces; xray off so it samples windows, not wallpaper.
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}
